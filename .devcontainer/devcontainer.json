{
  "name": "Rumoca workshop (CPU JAX + CasADi)",
  "image": "ghcr.io/cognipilot/rumoca_workshop_amc2026@sha256:4b80a38a77e2e625dd54cdc9bac89fe18fc1b87f181df742033692376a3059ff",
  "remoteUser": "vscode",
  "containerEnv": {
    "JAX_PLATFORMS": "cpu",
    "OMP_NUM_THREADS": "1",
    "OPENBLAS_NUM_THREADS": "1",
    "MKL_NUM_THREADS": "1"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "JamesGoppert.rumoca-modelica@0.10.2",
        "ms-python.python",
        "mathematic.vscode-pdf@0.1.11",
        "leanprover.lean4@0.0.240",
        "samuelcolvin.jinjahtml@0.20.0",
        "bierner.markdown-preview-github-styles@2.2.0",
        "openai.chatgpt@26.1007.21434",
        "anthropic.claude-code@2.1.296",
        "GitHub.copilot-chat"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "extensions.autoUpdate": false,
        "workbench.editorAssociations": {
          "*.pdf": "pdf.view"
        },
        "pdf.defaultZoomValue": "page-fit",
        "files.associations": {
          "*.py.jinja": "jinja-py"
        },
        "files.exclude": {
          "**/.*": false,
          "scripts": false,
          "verification": false,
          "formal": false,
          "templates": false,
          "browser": false,
          "extras": false,
          "docs": false,
          "data": false,
          "generated": false,
          "flake.nix": false,
          "flake.lock": false,
          "uv.lock": false,
          "pyproject.toml": false,
          "LICENSE": false,
          "models/Quadrotor_solution.mo": false,
          "results/reference": false,
          "slides/assets": false,
          "slides/build-report.json": false,
          "slides/workshop.md": false,
          "slides/*.pptx": false,
          "slides/PRESENTERS.md": false,
          "slides/REHEARSAL.md": false,
          "slides/media": false,
          ".git": true,
          ".venv": true,
          "**/__pycache__": true,
          "formal/.lake": true
        },
        "workbench.startupEditor": "readme",
        "explorer.excludeGitIgnore": false
      }
    }
  },
  "postCreateCommand": "uv run --frozen python scripts/install_agent_tools.py --check && uv run --frozen python scripts/install_rumoca_cli.py --check",
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb",
    "storage": "32gb"
  },
  "waitFor": "updateContentCommand",
  "shutdownAction": "stopContainer",
  "updateContentCommand": "uv sync --frozen --group torch && uv run --frozen python scripts/install_agent_tools.py --check && uv run --frozen python scripts/install_rumoca_cli.py --check && uv run --frozen python scripts/ensure_codespace_extension.py && uv run --frozen python scripts/smoke_test.py"
}
