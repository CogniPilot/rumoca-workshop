{
  "name": "Rumoca workshop (CPU JAX + CasADi)",
  "image": "ghcr.io/cognipilot/rumoca_workshop_amc2026@sha256:7f8454046ae9b1811d77c4913f3e9d203c32364bf2604d8e99b915ca52680751",
  "remoteUser": "vscode",
  "containerEnv": {
    "JAX_PLATFORMS": "cpu",
    "OMP_NUM_THREADS": "1",
    "OPENBLAS_NUM_THREADS": "1",
    "MKL_NUM_THREADS": "1"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "JamesGoppert.rumoca-modelica@0.10.2",
        "ms-python.python",
        "mathematic.vscode-pdf@0.1.11",
        "leanprover.lean4@0.0.240",
        "samuelcolvin.jinjahtml@0.20.0",
        "bierner.markdown-preview-github-styles@2.2.0",
        "openai.chatgpt@26.1007.21434",
        "anthropic.claude-code@2.1.296",
        "GitHub.copilot-chat"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "extensions.autoUpdate": false,
        "workbench.editorAssociations": {
          "*.pdf": "pdf.view"
        },
        "pdf.defaultZoomValue": "page-fit",
        "files.associations": {
          "*.py.jinja": "jinja-py"
        },
        "files.exclude": {
          "**/.*": true,
          "scripts": true,
          "verification": true,
          "formal": true,
          "templates": true,
          "browser": true,
          "extras": true,
          "docs": true,
          "data": true,
          "generated": true,
          "flake.nix": true,
          "flake.lock": true,
          "uv.lock": true,
          "pyproject.toml": true,
          "LICENSE": true,
          "models/Quadrotor_solution.mo": true,
          "results/reference": true,
          "slides/assets": true,
          "slides/build-report.json": true,
          "slides/workshop.md": true,
          "slides/*.pptx": true,
          "slides/PRESENTERS.md": true,
          "slides/REHEARSAL.md": true,
          "slides/media": true
        },
        "workbench.startupEditor": "readme"
      }
    }
  },
  "postCreateCommand": "uv run --frozen python scripts/install_agent_tools.py --check",
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb",
    "storage": "32gb"
  },
  "waitFor": "updateContentCommand",
  "shutdownAction": "stopContainer",
  "updateContentCommand": "uv sync --frozen --group torch && uv run --frozen python scripts/install_agent_tools.py --check && uv run --frozen python scripts/ensure_codespace_extension.py && uv run --frozen python scripts/smoke_test.py"
}
