{
  "name": "FastDyn + Rumoca: optional firmware Monte Carlo",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "../.."
  },
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/devcontainers/features/sshd:1": {},
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "containerEnv": {
    "JAX_PLATFORMS": "cpu",
    "OMP_NUM_THREADS": "1",
    "OPENBLAS_NUM_THREADS": "1",
    "MKL_NUM_THREADS": "1"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "JamesGoppert.rumoca-modelica@0.10.2",
        "ms-python.python",
        "mathematic.vscode-pdf@0.1.11",
        "leanprover.lean4@0.0.240",
        "samuelcolvin.jinjahtml@0.20.0",
        "bierner.markdown-preview-github-styles@2.2.0",
        "openai.chatgpt@26.1007.21434",
        "anthropic.claude-code@2.1.296",
        "GitHub.copilot-chat"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
        "extensions.autoUpdate": false,
        "workbench.editorAssociations": {
          "*.pdf": "pdf.view"
        },
        "pdf.defaultZoomValue": "page-fit",
        "files.associations": {
          "*.py.jinja": "jinja-py"
        },
        "files.exclude": {
          "**/.*": false,
          "scripts": false,
          "verification": false,
          "formal": false,
          "templates": false,
          "browser": false,
          "extras": false,
          "docs": false,
          "data": false,
          "generated": false,
          "flake.nix": false,
          "flake.lock": false,
          "uv.lock": false,
          "pyproject.toml": false,
          "LICENSE": false,
          "models/Quadrotor_solution.mo": false,
          "results/reference": false,
          "slides/assets": false,
          "slides/build-report.json": false,
          "slides/workshop.md": false,
          "slides/*.pptx": false,
          "slides/PRESENTERS.md": false,
          "slides/REHEARSAL.md": false,
          "slides/media": false,
          ".git": true,
          ".venv": true,
          "**/__pycache__": true,
          "formal/.lake": true
        },
        "explorer.excludeGitIgnore": false
      }
    }
  },
  "postCreateCommand": "uv sync --frozen --group torch && uv run --frozen python scripts/install_agent_tools.py --check && uv run --frozen python scripts/ensure_codespace_extension.py && uv run --frozen python scripts/smoke_test.py && uv run --frozen python scripts/fastdyn_demo.py --prepare",
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb",
    "storage": "32gb"
  },
  "waitFor": "postCreateCommand",
  "shutdownAction": "stopContainer"
}
