{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv",
  "files.associations": {
    "*.mo": "modelica",
    "*.py.jinja": "jinja-py"
  },
  "terminal.integrated.env.linux": {
    "JAX_PLATFORMS": "cpu",
    "OMP_NUM_THREADS": "1",
    "OPENBLAS_NUM_THREADS": "1"
  },
  "files.exclude": {
    "**/.*": false,
    "scripts": false,
    "verification": false,
    "formal": false,
    "templates": false,
    "browser": false,
    "extras": false,
    "docs": false,
    "data": false,
    "generated": false,
    "flake.nix": false,
    "flake.lock": false,
    "uv.lock": false,
    "pyproject.toml": false,
    "LICENSE": false,
    "models/Quadrotor_solution.mo": false,
    "results/reference": false,
    "slides/assets": false,
    "slides/build-report.json": false,
    "slides/workshop.md": false,
    "slides/*.pptx": false,
    "slides/PRESENTERS.md": false,
    "slides/REHEARSAL.md": false,
    "slides/media": false,
    ".git": true,
    ".venv": true,
    "**/__pycache__": true,
    "formal/.lake": true
  },
  "workbench.startupEditor": "readme",
  "explorer.excludeGitIgnore": false
}
