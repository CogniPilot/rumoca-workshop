{
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv",
  "files.associations": {
    "*.mo": "modelica",
    "*.py.jinja": "jinja-py"
  },
  "terminal.integrated.env.linux": {
    "JAX_PLATFORMS": "cpu",
    "OMP_NUM_THREADS": "1",
    "OPENBLAS_NUM_THREADS": "1"
  },
  "files.exclude": {
    "**/.*": true,
    "scripts": true,
    "verification": true,
    "formal": true,
    "templates": true,
    "browser": true,
    "extras": true,
    "docs": true,
    "data": true,
    "generated": true,
    "flake.nix": true,
    "flake.lock": true,
    "uv.lock": true,
    "pyproject.toml": true,
    "LICENSE": true,
    "models/Quadrotor_solution.mo": true,
    "results/reference": true,
    "slides/assets": true,
    "slides/build-report.json": true,
    "slides/workshop.md": true,
    "slides/*.pptx": true,
    "slides/PRESENTERS.md": true,
    "slides/REHEARSAL.md": true,
    "slides/media": true
  },
  "workbench.startupEditor": "readme"
}
