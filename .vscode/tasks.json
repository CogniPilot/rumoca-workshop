{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Workshop: simulate",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "--frozen",
        "python",
        "examples/simulate.py"
      ],
      "problemMatcher": []
    },
    {
      "label": "Workshop: JAX fit",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "--frozen",
        "python",
        "examples/fit_drag_jax.py"
      ],
      "problemMatcher": []
    },
    {
      "label": "Workshop: CasADi optimize",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "--frozen",
        "python",
        "examples/optimize_casadi.py"
      ],
      "problemMatcher": []
    },
    {
      "label": "Workshop: FMU and eFMU export",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "--frozen",
        "python",
        "examples/export_fmi.py"
      ],
      "problemMatcher": []
    },
    {
      "label": "Workshop: smoke test",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "--frozen",
        "python",
        "scripts/smoke_test.py"
      ],
      "problemMatcher": []
    },
    {
      "label": "Workshop: math audit",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "--frozen",
        "python",
        "scripts/math_audit.py",
        "--output",
        "results/live"
      ],
      "problemMatcher": []
    },
    {
      "label": "Workshop: CI checks",
      "dependsOn": [
        "Workshop: smoke test",
        "Workshop: math audit"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Workshop: optional Torch backend check",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "--frozen",
        "--group",
        "torch",
        "python",
        "scripts/check_torch_backend.py"
      ],
      "problemMatcher": []
    },
    {
      "label": "Workshop: optional Torch policy learning",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "--frozen",
        "--group",
        "torch",
        "python",
        "scripts/learn_hover_torch.py"
      ],
      "problemMatcher": []
    },
    {
      "label": "Workshop: optional FastDyn Monte Carlo",
      "type": "process",
      "command": "uv",
      "args": [
        "run",
        "--frozen",
        "python",
        "scripts/fastdyn_demo.py"
      ],
      "problemMatcher": []
    },
    {
      "label": "Workshop: Codex terminal (tmux)",
      "type": "process",
      "command": "tmux",
      "args": [
        "new-session",
        "-A",
        "-s",
        "workshop-codex",
        "codex"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "Workshop: Claude terminal (tmux)",
      "type": "process",
      "command": "tmux",
      "args": [
        "new-session",
        "-A",
        "-s",
        "workshop-claude",
        "claude"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    },
    {
      "label": "Workshop: Copilot terminal (tmux)",
      "type": "process",
      "command": "tmux",
      "args": [
        "new-session",
        "-A",
        "-s",
        "workshop-copilot",
        "copilot"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    }
  ]
}
