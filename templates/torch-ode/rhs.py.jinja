{# Small, deliberately limited teaching backend. No vehicle equations here. #}
{% for variable in dae.variables %}{% for name in variable.scalar_names %}{% if "'" in name or "\\" in name or "\n" in name %}{{ fail("torch teaching target requires plain scalar names") }}{% endif %}{% endfor %}{% endfor %}
{% set binary = {"Add": "+", "Sub": "-", "Mul": "*", "Div": "/"} -%}
{% set unary = {"Sin": "sin", "Cos": "cos", "Sqrt": "sqrt"} -%}
# Generated by Rumoca {{ model_name }} -> workshop-torch-ode.
# rhs(t, x, u, p) accepts scalar or broadcastable batch dimensions.
import torch

N_Y = {{ solve.solve_layout.state_scalar_count }}
N_U = {{ solve.solve_layout.input_scalar_names | length }}
N_P = {{ solve.solve_layout.parameter_count }}
PAD = {{ solve.solve_layout.compiled_parameter_len }} - N_P - N_U
STATE_NAMES = [{% for name in solve.solve_layout.solver_maps.names %}{% if loop.index0 < solve.solve_layout.state_scalar_count %}'{{ name }}', {% endif %}{% endfor %}]
INPUT_NAMES = [{% for name in solve.solve_layout.input_scalar_names %}'{{ name }}', {% endfor %}]
PARAM_NAMES = [{% for role in ["parameter", "constant"] %}{% for variable in dae.variables %}{% if variable.role == role %}{% for name in variable.scalar_names %}'{{ name }}', {% endfor %}{% endif %}{% endfor %}{% endfor %}]


def rhs(t, x, u, p):
    x = torch.as_tensor(x, dtype=torch.float64)
    u = torch.as_tensor(u, dtype=x.dtype, device=x.device)
    p = torch.as_tensor(p, dtype=x.dtype, device=x.device)
    t = torch.as_tensor(t, dtype=x.dtype, device=x.device)
    if x.ndim == 0 or u.ndim == 0 or p.ndim == 0:
        raise ValueError("x, u and p need a final state/input/parameter dimension")
    if x.shape[-1] != N_Y or u.shape[-1] != N_U or p.shape[-1] != N_P:
        raise ValueError("Expected final dimensions (N_Y, N_U, N_P)")
    batch = torch.broadcast_shapes(t.shape, x.shape[:-1], u.shape[:-1], p.shape[:-1])
    t = t.expand(batch)
    x = x.expand(batch + (N_Y,))
    u = u.expand(batch + (N_U,))
    p = p.expand(batch + (N_P,))
    P = torch.cat((p, u, torch.zeros(batch + (PAD,), dtype=x.dtype, device=x.device)), dim=-1)
    out = [None] * N_Y
{% if solve_blocks.continuous.derivative_rhs.output_count != solve.solve_layout.state_scalar_count %}{{ fail("torch teaching target needs one explicit derivative per state") }}{% endif -%}
{% for program in solve_blocks.continuous.derivative_rhs.scalar_plan.programs -%}
{% for op in program.ops -%}
{% if op.kind == "Const" %}{% if op.value_class != "finite" %}{{ fail("torch teaching target requires finite constants") }}{% endif %}
    r{{ op.dst }} = {{ op.value }}
{% elif op.kind == "LoadY" %}
    r{{ op.dst }} = x[..., {{ op.index }}]
{% elif op.kind == "LoadP" %}
    r{{ op.dst }} = P[..., {{ op.index }}]
{% elif op.kind == "LoadTime" %}
    r{{ op.dst }} = t
{% elif op.kind == "Move" %}
    r{{ op.dst }} = r{{ op.src }}
{% elif op.kind == "Unary" and op.operator == "Neg" %}
    r{{ op.dst }} = -r{{ op.arg }}
{% elif op.kind == "Unary" and op.operator in unary %}
    r{{ op.dst }} = torch.{{ unary[op.operator] }}(r{{ op.arg }})
{% elif op.kind == "Binary" and op.operator in binary %}
    r{{ op.dst }} = r{{ op.lhs }} {{ binary[op.operator] }} r{{ op.rhs }}
{% elif op.kind == "StoreOutput" %}
    out[{{ op.output_index }}] = torch.zeros_like(x[..., 0]) + r{{ op.src }}
{% else %}{{ fail("unsupported-feature:workshop-torch." ~ op.kind ~ "." ~ op.operator) }}
{% endif -%}
{% endfor -%}
{% endfor %}
    return torch.stack(out, dim=-1)
